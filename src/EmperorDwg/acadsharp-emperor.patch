+	/// </summary>
+	public List<Viewport> ViewportOrder { get; } = new List<Viewport>();
+
+	/// <summary>
+	/// Emperor patch: the viewports of the layout, in the order they must be written.
+	/// </summary>
+	public IEnumerable<Viewport> OrderedViewports
+	{
+		get
+		{
+			var all = this.Viewports == null ? new List<Viewport>() : this.Viewports.ToList();
+			var result = new List<Viewport>();
+			foreach (Viewport v in this.ViewportOrder)
+			{
+				if (all.Contains(v) && !result.Contains(v)) result.Add(v);
+			}
+			foreach (Viewport v in all)
+			{
+				if (!result.Contains(v)) result.Add(v);
+			}
+			return result;
+		}
+	}
