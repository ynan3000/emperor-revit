<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Emperor - Claude Connector" Width="600" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F8F8F8" FontFamily="Segoe UI" ShowInTaskbar="False">
    <Window.Resources>
        <!--EMPEROR_THEME-->
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource HeaderBrush}" Padding="20,10">
            <StackPanel>
                                <TextBlock Text="Claude Connector" Foreground="White" FontSize="19" FontWeight="Bold"/>
                <TextBlock Text="Let Claude Desktop work with the Revit project you have open."
                           Foreground="White" FontSize="11.5" Opacity="0.9" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="20,12,20,12">
            <TextBlock Text="STATUS" Foreground="{StaticResource Red}" FontWeight="Bold" FontSize="12"/>
            <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6"
                    Background="White" Padding="12,10" Margin="0,4,0,0">
                <StackPanel>
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Ellipse x:Name="dot_routes" Width="12" Height="12" Fill="Gray" VerticalAlignment="Top" Margin="0,2,0,0"/>
                        <TextBlock x:Name="txt_routes" Grid.Column="1" TextWrapping="Wrap" FontSize="12"/>
                    </Grid>
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Ellipse x:Name="dot_python" Width="12" Height="12" Fill="Gray" VerticalAlignment="Top" Margin="0,2,0,0"/>
                        <TextBlock x:Name="txt_python" Grid.Column="1" TextWrapping="Wrap" FontSize="12"/>
                    </Grid>
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Ellipse x:Name="dot_server" Width="12" Height="12" Fill="Gray" VerticalAlignment="Top" Margin="0,2,0,0"/>
                        <TextBlock x:Name="txt_server" Grid.Column="1" TextWrapping="Wrap" FontSize="12"/>
                    </Grid>
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Ellipse x:Name="dot_claude" Width="12" Height="12" Fill="Gray" VerticalAlignment="Top" Margin="0,2,0,0"/>
                        <TextBlock x:Name="txt_claude" Grid.Column="1" TextWrapping="Wrap" FontSize="12"/>
                    </Grid>
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Ellipse x:Name="dot_script" Width="12" Height="12" Fill="Gray" VerticalAlignment="Top" Margin="0,2,0,0"/>
                        <TextBlock x:Name="txt_script" Grid.Column="1" TextWrapping="Wrap" FontSize="12"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Ellipse x:Name="dot_write" Width="12" Height="12" Fill="Gray" VerticalAlignment="Top" Margin="0,2,0,0"/>
                        <TextBlock x:Name="txt_write" Grid.Column="1" TextWrapping="Wrap" FontSize="12"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Button x:Name="btn_connect" Content="Reconnect + restart Claude Desktop" Style="{StaticResource RedBtn}" Height="32"
                    Margin="0,10,0,0" Click="on_connect"/>
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="btn_write" Content="Write access" Style="{StaticResource OutlineBtn}" Height="30" Margin="0" Click="on_toggle_write"/>
                <Button x:Name="btn_script" Grid.Column="2" Content="Scripting access" Style="{StaticResource OutlineBtn}" Height="30" Margin="0" Click="on_toggle_script"/>
            </Grid>
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="btn_ext" Visibility="Collapsed" Content="Claude Desktop extension (icon)" Style="{StaticResource OutlineBtn}" Height="30" Margin="0"
                        Click="on_install_ext" ToolTip="Install Emperor Revit as a Claude Desktop extension - it shows the Emperor icon. Emperor then removes its old settings entry so the tools are not listed twice."/>
                <Button x:Name="btn_code" Grid.Column="0" Grid.ColumnSpan="3" Content="Set up Claude Code (skill)" Style="{StaticResource OutlineBtn}" Height="30" Margin="0"
                        Click="on_claude_code" ToolTip="Install the Emperor Revit Skills skill and the connector in Claude Code."/>
            </Grid>
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Content="Copy config (other clients)" Style="{StaticResource OutlineBtn}" Height="30" Margin="0" Click="on_copy"/>
                <Button Grid.Column="2" Content="Refresh" Style="{StaticResource OutlineBtn}" Height="30" Margin="0" Click="on_refresh"/>
            </Grid>

            <CheckBox x:Name="chk_auto" Content="Connect Claude automatically whenever Revit starts"
                      Margin="0,10,0,0" FontSize="12" Foreground="#333333"
                      Checked="on_auto_changed" Unchecked="on_auto_changed"/>

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="TOOLS GIVEN TO CLAUDE" Foreground="{StaticResource Red}" FontWeight="Bold" FontSize="11"/>
                    <ComboBox x:Name="cb_profile" Height="28" Margin="0,3,0,0" SelectionChanged="on_profile_changed"
                              ToolTip="Fewer tools = fewer tokens in every message. Claude Desktop restarts to load the change.">
                        <ComboBoxItem Content="All tools (incl. scripts)"/>
                        <ComboBoxItem Content="Modeling (no scripts)"/>
                        <ComboBoxItem Content="Read-only (fewest tokens)"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="PROJECT MEMORY" Foreground="{StaticResource Red}" FontWeight="Bold" FontSize="11"/>
                    <Button Content="Open Project Memory" Style="{StaticResource OutlineBtn}" Height="28" Margin="0,3,0,0"
                            Click="on_memory" ToolTip="What Claude remembers per project: model facts, your standards and notes (one file per project)."/>
                </StackPanel>
            </Grid>

            <TextBlock x:Name="txt_next" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="11.5" Foreground="#555555"/>

            <Button Content="Close" Style="{StaticResource OutlineBtn}" Width="100" Height="30"
                    HorizontalAlignment="Right" Margin="0,8,0,0" Click="on_close"/>
        </StackPanel>
    </Grid>
</Window>
