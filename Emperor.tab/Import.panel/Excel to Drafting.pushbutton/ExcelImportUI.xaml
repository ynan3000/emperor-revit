<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Emperor - Excel to Drafting" Height="560" Width="580" MinHeight="480" MinWidth="500"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="#F8F8F8" FontFamily="Segoe UI" FontSize="12.5">
    <Window.Resources>
        <!--EMPEROR_THEME-->
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource HeaderBrush}" Padding="20,12">
            <StackPanel>
                <TextBlock Text="EXCEL TO DRAFTING" Foreground="White" FontSize="19" FontWeight="Bold"/>
                <TextBlock Text="Bring an Excel print area into a Revit drafting view - colours, fonts, merged cells and images"
                           Foreground="#F7DDE0" FontSize="11.5" Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Margin="10" Background="White" BorderBrush="{StaticResource Line}"
                BorderThickness="1" CornerRadius="6" Padding="14,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="1.  EXCEL FILE(S)" Foreground="{StaticResource Red}" FontWeight="Bold" Margin="0,0,0,6"/>

                <Border Grid.Row="1" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5" MinHeight="110">
                    <ListBox Name="lb_files" BorderThickness="0" SelectionMode="Extended"
                             ToolTip="Ctrl / Shift + click to pick several files, then Remove selected."/>
                </Border>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,12">
                    <Button Name="btn_add" Content="Add files..." Style="{StaticResource RedBtn}" MinWidth="110"
                            ToolTip="Pick one or several .xlsx files."/>
                    <Button Name="btn_remove" Content="Remove selected" Style="{StaticResource OutlineBtn}" MinWidth="130"/>
                </StackPanel>

                <StackPanel Grid.Row="3" Margin="0,0,0,10">
                    <TextBlock Text="2.  MODE" Foreground="{StaticResource Red}" FontWeight="Bold" Margin="0,0,0,4"/>
                    <RadioButton Name="rb_new" Content="Create new drafting view(s) - one per Excel file"
                                 GroupName="mode" IsChecked="True"/>
                    <RadioButton Name="rb_update" Content="Update an existing drafting view (single file only)"
                                 GroupName="mode"/>
                </StackPanel>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="View name:" Name="lbl_viewname" VerticalAlignment="Center"
                               Foreground="{StaticResource Muted}"/>
                    <TextBox Grid.Column="1" Name="tb_viewname" Height="28" VerticalAlignment="Center" Padding="6,0" VerticalContentAlignment="Center"
                             ToolTip="Leave blank to name each view after its Excel file. With several files this is used as a shared prefix."/>

                    <TextBlock Grid.Column="0" Text="Target view:" Name="lbl_targetview" VerticalAlignment="Center"
                               Foreground="{StaticResource Muted}" Visibility="Collapsed"/>
                    <ComboBox Grid.Column="1" Name="cb_views" Height="28" VerticalAlignment="Center"
                              Visibility="Collapsed" ToolTip="Everything this tool drew before in that view is cleared and drawn again."/>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="#F3E9EA" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="14,8">
            <DockPanel>
                <Button Name="btn_cancel" DockPanel.Dock="Right" Content="Cancel" Style="{StaticResource OutlineBtn}"
                        MinWidth="90" Margin="8,0,0,0" IsCancel="True"/>
                <Button Name="btn_ok" DockPanel.Dock="Right" Content="Import" Style="{StaticResource RedBtn}"
                        MinWidth="90" Margin="8,0,0,0" IsDefault="True"/>
                <TextBlock VerticalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="11.5" TextWrapping="Wrap"
                           Text="Set the Print Area in Excel first; the active sheet is imported."/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
